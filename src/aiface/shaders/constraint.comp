#version 430

//#prelude

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly restrict buffer SourceWorld {
    Cell cells[];
} source_world;

layout(std430, binding = 1) writeonly restrict buffer DestinationWorld {
    Cell cells[];
} destination_world;

layout(std430, binding = 2) readonly restrict buffer CommandBuffer {
    PaintCommand commands[];
} command_buffer;

uniform uvec2 grid_size;
uniform uint command_count;

const float PRIORITY_TOLERANCE = 1e-4;

uint cell_index(uvec2 position) {
    return position.y * grid_size.x + position.x;
}

// What a cell *is* must not depend on how hard it was just pushed, so the
// transient velocity sub-vector is excluded from the quantisation trigger.
// Including it let one loud speech impulse re-anchor soft mouth tissue to
// vacuum, silently erasing the density the seed gave it to push against.
float snap_trigger(float state[CHANNELS], int group) {
    if (group != 0) {
        return group_norm(state, group);
    }
    float total = 0.0;
    for (int offset = VELOCITY_CHANNELS; offset < 8; ++offset) {
        float component = state[offset];
        total += component * component;
    }
    return sqrt(total);
}

void snap_group(inout float state[CHANNELS], int group) {
    if (snap_trigger(state, group) <= SNAP_THRESHOLD) {
        return;
    }
    int first = group * 8;
    int nearest = 0;
    float nearest_distance = 3.402823e38;
    for (int anchor = 0; anchor < ANCHOR_COUNT; ++anchor) {
        float distance_squared = 0.0;
        for (int offset = 0; offset < 8; ++offset) {
            int channel = first + offset;
            float delta = state[channel] - anchor_value(anchor, channel);
            distance_squared += delta * delta;
        }
        if (distance_squared < nearest_distance) {
            nearest_distance = distance_squared;
            nearest = anchor;
        }
    }
    for (int offset = 0; offset < 8; ++offset) {
        int channel = first + offset;
        state[channel] = anchor_value(nearest, channel);
    }
}

void main() {
    uvec2 position = gl_GlobalInvocationID.xy;
    if (position.x >= grid_size.x || position.y >= grid_size.y) {
        return;
    }

    uint index = cell_index(position);
    float state[CHANNELS];
    for (int channel = 0; channel < CHANNELS; ++channel) {
        state[channel] = source_world.cells[index].value[channel];
    }

    // Every unlocked cell is bounded and relaxes, hard surface or not. Gating
    // this on the hard-surface flag left the lip outline free to accumulate
    // impulses forever, past CLAMP_LIMIT, with nothing to bring it back.
    if (!is_locked(state)) {
        for (int channel = 0; channel < PRIORITY_CHANNEL; ++channel) {
            state[channel] = clamp(state[channel], -CLAMP_LIMIT, CLAMP_LIMIT);
        }
        // Speech energy is transient, and no physics pass ships here to
        // dissipate it. Without this relaxation the impulse field only ever
        // climbs, pinning every mouth cell at the clamp after a few phonemes.
        // Landing exactly on rest keeps a resting world a fixed point on save.
        for (int channel = 0; channel < VELOCITY_CHANNELS; ++channel) {
            float relaxed = state[channel] * VELOCITY_DAMPING;
            state[channel] = abs(relaxed) < EMPTY_EPSILON ? 0.0 : relaxed;
        }
        // Quantisation is for matter, not for walls: a hard surface keeps the
        // exact material the seed gave it.
        if (state[24] < 0.5) {
            // Authority channels are never diffused or snapped; only commands own them.
            for (int group = 0; group < 3; ++group) {
                snap_group(state, group);
            }
            if (abs(state[3]) < EMPTY_EPSILON && group_norm(state, 1) < EMPTY_EPSILON) {
                state[PRIORITY_CHANNEL] = 0.0;
            }
        }
    }

    vec2 cell_center = vec2(position) + vec2(0.5);
    uint safe_count = min(command_count, uint(MAX_COMMANDS));
    for (uint slot = 0u; slot < safe_count; ++slot) {
        PaintCommand command = command_buffer.commands[slot];
        float radius = max(command.settings.x, 0.5);
        // operation magnitude marks the writer/kind:
        // ±1 = human paint/erase, ±2 = AI paint/erase,
        // ±3 = temperature delta, ±4 = velocity impulse (V_x, V_y).
        float operation = command.settings.z;
        bool is_velocity = abs(operation) > 3.5;
        bool is_temperature = abs(operation) > 2.5 && !is_velocity;
        // Velocity packs (V_x, V_y) into segment.zw, so coverage is a disc
        // around segment.xy rather than a capsule to that vector.
        float coverage = is_velocity
            ? distance(cell_center, command.segment.xy)
            : distance_to_segment(cell_center, command.segment.xy, command.segment.zw);
        if (coverage > radius) {
            continue;
        }

        bool erase = operation < -0.5 && abs(operation) < 2.5;
        bool is_ai = abs(operation) > 1.5;
        // Absolute lock enforcement: AI may never overwrite human-locked cells.
        if (is_ai && state[HUMAN_LOCK_CHANNEL] >= 0.5) {
            continue;
        }

        float command_priority = clamp(command.settings.w, 0.0, 1.0);
        if (command_priority + PRIORITY_TOLERANCE < state[PRIORITY_CHANNEL]) {
            continue;
        }

        if (is_velocity) {
            vec2 impulse = command.segment.zw;
            state[0] = clamp(state[0] + impulse.x, -CLAMP_LIMIT, CLAMP_LIMIT);
            state[1] = clamp(state[1] + impulse.y, -CLAMP_LIMIT, CLAMP_LIMIT);
            continue;
        }

        if (is_temperature) {
            float delta = max(command.settings.y, 0.0);
            if (operation < 0.0) {
                delta = -delta;
            }
            state[6] = clamp(state[6] + delta, -CLAMP_LIMIT, CLAMP_LIMIT);
            continue;
        }

        // Paint copies every channel from the anchor table, and one anchor
        // (human_barrier) carries a lock. Minting a boundary that AI writes can
        // then never cross is a human act, so remember the cell's own lock and
        // refuse to let an AI write raise it. Without this an agent could wall
        // off regions that it is itself permanently barred from clearing.
        // Human writes still own the channel outright.
        int anchor = erase ? 0 : clamp(int(round(command.settings.y)), 0, ANCHOR_COUNT - 1);
        float prior_lock = state[HUMAN_LOCK_CHANNEL];
        for (int channel = 0; channel < CHANNELS; ++channel) {
            state[channel] = anchor_value(anchor, channel);
        }
        if (is_ai) {
            state[HUMAN_LOCK_CHANNEL] = min(prior_lock, state[HUMAN_LOCK_CHANNEL]);
        }
        state[PRIORITY_CHANNEL] = erase ? 0.0 : command_priority;
    }

    for (int channel = 0; channel < CHANNELS; ++channel) {
        destination_world.cells[index].value[channel] = state[channel];
    }
}
